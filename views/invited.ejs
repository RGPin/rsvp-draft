<div class="invited-container">
  <h1>You, <%= invited['guest_name'] %>, are invited</h1>
  <p>
    <strong
      ><i>Please check if this you else <a href="/">try again</a></i></strong
    >
  </p>
  <form method="POST" action="/response/<%= invited.token %>">
    <div>
      <input
        type="radio"
        id="accept"
        name="response"
        value="accept"
        checked
        required
      />
      <label for="accept">Accept</label>
    </div>

    <div>
      <input type="radio" id="decline" name="response" value="decline" />
      <label for="decline">Decline</label>
    </div>
    <button type="submit">Submit response</button>
  </form>
</div>
