            </article>

            <article class="entourage-card">
              <h3>Bible Bearer</h3>
              <ul class="entourage-card-list">
                <li>Karen</li>
              </ul>
            </article>

            <article class="entourage-card">
              <h3>Coin Bearer</h3>
              <ul class="entourage-card-list">
